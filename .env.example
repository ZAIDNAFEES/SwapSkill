# ==============================================================================
# SERVER-SIDE SECRETS (Add these in Vercel Project Settings > Environment Variables)
# DO NOT PREFIX WITH VITE_ (Keeps credentials hidden from client/APK)
# ==============================================================================

# Gemini AI API Key (For AI matchmaking & smart assistant features)
GEMINI_API_KEY="AIzaSy..."

# WebRTC TURN / STUN Server Configuration (Production NAT traversal & relay fallback)
# Securely loaded on backend only (/api/webrtc/ice-servers) - NEVER exposed in frontend bundles
# Example for Metered / Coturn:
TURN_URL="turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp"
TURN_USERNAME="13748a1862f0e5316c1a9877"
TURN_CREDENTIAL="9cgHjuE4wpy1L/Dq"

# Firebase Cloud Messaging (FCM) v1 Service Account JSON (Recommended - paste downloaded service account JSON)
FIREBASE_SERVICE_ACCOUNT=""
# Legacy FCM Server Key (Deprecated fallback)
FCM_SERVER_KEY=""

# Apple PushKit VoIP (APNs HTTP/2) Configuration
# Required for native iOS lock-screen and terminated-app CallKit ringing
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_BUNDLE_ID="com.swapskill.app"
APNS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
APNS_SANDBOX="false"

# ==============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed in Web and Android/iOS APK bundle)
# ==============================================================================

# Backend API Endpoint URL:
# - On Web (Vercel): Leave empty or set to your domain (defaults to same-origin /api/...)
# - On Android/iOS APK: MUST be set at BUILD TIME to your deployed Vercel domain!
#   Example: VITE_API_URL="https://swap-skill1.vercel.app/"
VITE_API_URL=""
VITE_BACKEND_URL=""
# Optional public domain for shared profile links (defaults to current web origin or Vercel URL)
VITE_PUBLIC_APP_URL=""

# Cloudinary Storage Configuration (For client-side image uploading on Firebase Spark Tier)
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Optional Client-Side WebRTC TURN Configuration (Fallback if backend ice-servers is unreachable)
VITE_TURN_URL=""
VITE_TURN_USERNAME=""
VITE_TURN_CREDENTIAL=""

# Firebase Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""

# Google Sign-In Native Client IDs
VITE_GOOGLE_IOS_CLIENT_ID=""

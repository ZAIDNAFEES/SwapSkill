# ==============================================================================
# SERVER-SIDE SECRETS (Add these in Vercel Project Settings > Environment Variables)
# DO NOT PREFIX WITH VITE_ (Keeps credentials hidden from client/APK)
# ==============================================================================

# LiveKit Cloud Configuration (Obtain from https://cloud.livekit.io)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="APIxxxxxxxxxxxx"
LIVEKIT_API_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Gemini AI API Key (For AI matchmaking & smart assistant features)
GEMINI_API_KEY="AIzaSy..."

# ==============================================================================
# CLIENT-SIDE ENVIRONMENT VARIABLES (Exposed in Web and Android/iOS APK bundle)
# ==============================================================================

# Backend API Endpoint URL:
# - On Web (Vercel): Leave empty or set to your domain (defaults to same-origin /api/...)
# - On Android/iOS APK: MUST be set at BUILD TIME to your deployed Vercel domain!
#   Example: VITE_API_URL="https://your-swapskill.vercel.app"
VITE_API_URL=""
VITE_BACKEND_URL=""

# Cloudinary Storage Configuration (For client-side image uploading on Firebase Spark Tier)
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET=""

# Firebase Configuration
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_DATABASE_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
